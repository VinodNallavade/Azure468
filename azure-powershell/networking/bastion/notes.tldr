											"type": "highlight"
										},
										{
											"type": "bold"
										}
									],
									"text": "provides secure Remote Desktop Protocol (RDP) and Secure Shell (SSH) connectivity to Azure virtual machines over TLS (port 443) without exposing them to the public internet"
								},
								{
									"type": "text",
									"text": ". ["
								},
