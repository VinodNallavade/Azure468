												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Service Endpoint:"
												},
												{
													"type": "text",
													"text": " Your Azure Storage Account continues to use its public IP address. Azure recognizes the originating subnet and allows you to configure subnet-based firewall rules."
