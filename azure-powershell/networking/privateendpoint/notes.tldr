												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Private Endpoint:"
												},
												{
													"type": "text",
													"text": " Your Azure Storage Account becomes accessible through a "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "private IP address from your VNet"
												},
												{
													"type": "text",
													"text": " using Azure Private Link."
												}
											]
										}
									]
								}
							]
